rules_version = '2';

// Cloud Storage rules for the RMS release bucket.
//
// Release artifacts are downloaded by the app using the Firebase ID token of
// the signed-in operator, so security rules — not bucket visibility — decide
// who may fetch what.
//
// Deploy these from the Firebase console:
//   Storage -> Rules -> paste -> Publish
//
// The Admin SDK used by CI bypasses these rules entirely: a server writing a
// release is authorised by IAM instead. Rules govern *devices*, never CI.

service firebase.storage {
  match /b/{bucket}/o {

    // Release artifacts: readable only by an authenticated device.
    match /releases/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Anything placed outside releases/ is not part of the update pipeline and
    // is denied outright. Add an explicit match here if that changes.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}