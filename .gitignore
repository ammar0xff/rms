# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# Node / Astro. The Astro UI lives in web-astro/ and is worked on locally but
# never committed whole: its node_modules is ~235MB across ~12.5k files, which
# the remote rejects. Note that `web/` is NOT ignored — that path belongs to
# Flutter, which the Pages workflow generates via `flutter create . --platforms
# web` on every run.
node_modules/
.astro/
dist/

# Stitch design exports. Pulled by tool/build_web_ui.py from the Stitch API and
# regenerated on demand — they are source material for the port, not app code.
.design-export/

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Secrets (Firebase / env)
*.env
google-services.json
GoogleService-Info.plist
firebase_options.dart
.playwright-mcp/

# Android release signing material. The keystore is what identifies this app to
# an installed device: committing it would let anyone publish an update that
# Android accepts as ours. `android/.gitignore` covers the paths the release
# workflow actually uses, so these rules are defence in depth for a key that
# gets created somewhere else. Losing a keystore is just as serious as leaking
# one — without it no new release can update an existing install — so the real
# backup lives outside the repository, documented in docs/release-setup.md.
*.keystore
*.jks
key.properties
local.properties
docs/*.swp

# Product requirement docs are the user's, not the repo's. They stay on disk
# and are never committed.
docs/Restaurant_Management_System_PRD_*
