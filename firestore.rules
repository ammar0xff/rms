rules_version = '2';

// Reviewed 2026-10-15. Apply in the Firebase console (Firestore Database >
// Rules) — these live here so changes are reviewable; the console is
// authoritative until the rules are deployed from here.
//
// Principles:
// - Everything requires a signed-in operator. There are no public reads.
// - Clients never mint order numbers or publish releases: counters are
//   unreadable and releases/activeReleases are read-only. The Admin SDK used
//   by the release publisher bypasses rules entirely.
// - Team membership gates itself: anyone signed in can read and initialize
//   their own user document; listing and managing other accounts need a
//   manager/developer role.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Role of the caller, or '' when they have no user document yet.
    //
    // Guarded by exists() on purpose. Rules do not short-circuit `||`: an
    // error in either operand denies the whole expression. A bare get() on a
    // missing document is such an error, so without the guard every rule that
    // consults a role would also deny the branch meant to stay open — which is
    // what made the first account impossible to create from the app.
    function myRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.get('role', '')
        : '';
    }

    function isPrivileged() {
      return myRole() == 'manager' || myRole() == 'developer';
    }

    // Operator accounts and roles.
    match /users/{uid} {
      // Anyone reads their own document (this is how sign-in resolves roles).
      allow get: if signedIn() && request.auth.uid == uid;
      // Managers and developers list the team and read any member.
      allow get, list: if signedIn() && isPrivileged();
      // An operator may initialise and maintain their OWN profile — but never
      // their own role. `role` is exactly what isPrivileged() reads, so letting
      // the subject write it turns every signed-in account into a manager: one
      // write of role:'manager' buys read on every user document plus write on
      // settings/, which holds the manager PIN. "Enforced in the app" is not a
      // control here — a client can talk to Firestore directly and skip the app
      // entirely.
      //
      // So: on create the field must be absent, on update it must be unchanged.
      // Managers and developers keep unrestricted write, so handing out roles
      // remains their job.
      allow create: if signedIn() && (
        isPrivileged() ||
        (request.auth.uid == uid && !request.resource.data.keys().hasAny(['role']))
      );
      allow update: if signedIn() && (
        isPrivileged() ||
        (request.auth.uid == uid
          && request.resource.data.get('role', '') == resource.data.get('role', ''))
      );
      allow delete: if false;
    }

    // Terminal security settings (manager PIN hash). Privileged roles
    // only: the document holds a salted hash, never the PIN, and only
    // managers set or rotate it.
    match /settings/{id} {
      allow read, write: if signedIn() && isPrivileged();
    }

    // Offline outbox drain: the sync engine's write path.
    match /sync_operations/{id} {
      allow read, write: if signedIn();
    }

    // Data mirrors: on every acknowledgement the app upserts the current
    // record snapshot here (merge by stable local id), so Firestore holds
    // readable orders/, payments/, … instead of only the opaque op log. Same
    // bar as the outbox — any signed-in operator reads and writes — because
    // the team screens read these directly. Best-effort from the client, so a
    // denied write only delays convergence; the outbox stays authoritative.
    match /orders/{id} {
      allow read, write: if signedIn();
    }
    match /payments/{id} {
      allow read, write: if signedIn();
    }
    match /collections/{id} {
      allow read, write: if signedIn();
    }
    match /deliveries/{id} {
      allow read, write: if signedIn();
    }
    match /purchases/{id} {
      allow read, write: if signedIn();
    }
    match /suppliers/{id} {
      allow read, write: if signedIn();
    }
    match /kitchenTickets/{id} {
      allow read, write: if signedIn();
    }
    match /stockMovements/{id} {
      allow read, write: if signedIn();
    }
    match /inventoryItems/{id} {
      allow read, write: if signedIn();
    }
    match /cashSessions/{id} {
      allow read, write: if signedIn();
    }
    match /approvals/{id} {
      allow read, write: if signedIn();
    }
    match /customers/{id} {
      allow read, write: if signedIn();
    }
    match /menu/{id} {
      allow read, write: if signedIn();
    }

    // Server-assigned order numbers. The reservation is a client-side
    // transaction (there is no server process), so denying it here does not
    // protect numbering — it prohibits order sync entirely, while payments
    // and tickets flow fine around it. Authenticated clients may read and run
    // the transaction: atomicity still makes duplicates impossible, and the
    // worst a rogue client can do is burn numbers (gaps, not collisions).
    // A failed reservation fails the push loudly instead of syncing a
    // numberless order.
    match /counters/{id} {
      allow read, write: if signedIn();
    }

    // Published releases and the per-platform pointer. Read-only to clients;
    // only the release publisher (Admin SDK) writes them. Note: the app no
    // longer reads these for updates (it tracks GitHub Releases); they stay
    // readable during the transition for pre-0.14.0 clients.
    match /releases/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /activeReleases/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
